# Existing MongoDB server and database; no data migration is required.
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=junkyard
# Set these to your EXISTING collection names.
MONGO_COLLECTION_NAME_JACKS=jacks
MONGO_COLLECTION_NAME_LKQ=lkq
MONGO_COLLECTION_NAME_PICKNPULL=picknpull
MONGO_COLLECTION_NAME_PULLAPART=pullapart
MONGO_COLLECTION_NAME_UPULLANDSAVE=upullandsave
MONGO_COLLECTION_NAME_TEARAPART=tearapart
MONGO_COLLECTION_NAME_UTPAP=utpap
MONGO_COLLECTION_NAME_PULLNSAVE=pullnsave
# Worker only. Use HOME_ASSISTANT_WEBHOOK_URL_<YARD> for per-yard destinations.
HOME_ASSISTANT_WEBHOOK_URL=
SCRAPER_YARDS=jacks,lkq,picknpull,pullapart,upullandsave
# 3600 runs on startup, then at each local top of the hour.
# Other values use a custom interval from each cycle's start (minimum 60 seconds).
SCRAPER_INTERVAL_SECONDS=3600
SCRAPER_TIMEOUT_SECONDS=1800
LKQ_PROXY_URL=http://cloudflare-bypass:8000
